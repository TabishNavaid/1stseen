# Every variable 1stSeen reads. `npm run preflight` checks a filled-in copy and says what
# breaks without each one; docs/PRODUCTION_CHECKLIST.md says where each lives in production.
#
# A line that has no safe default is commented out, not left blank: the worker types URLs,
# numbers, and booleans, and a present-but-blank one (`SUPABASE_URL=`) stops every worker
# command at startup.

# Required. `scripts/local-rig.sh env` fills the Supabase values for the local rig.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are server/worker only: together they are the
# switch that turns the product from "Not configured" into real data.
# SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe and inlined into the bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
FIRSTSEEN_ENV=development
# The one contact address the terms, privacy, data-source, and contact pages give, including for takedown
# requests (docs/takedown.md). Server-side and not secret; required in production. Unset, /contact says no
# address is configured. The address below is not yet confirmed to receive mail: set it on the Worker only
# once forwarding is confirmed.
# FIRSTSEEN_CONTACT_EMAIL=hello@1stseen.win

# Direct Postgres connection for `npm run verify:supabase`, `metrics:corpus`, and
# `test:integration` only. Never used by the web app or the worker. Secret.
# SUPABASE_DB_URL=
# Optional prefix that runs pg_dump/pg_restore for scripts/backup-corpus.mjs, when the local client is older than the
# server (docs/operations.md). The corpus backup workflow sets it to a postgres:17 container.
# BACKUP_PG_TOOLS=
# Path to Supabase's root certificate, for any hosted SUPABASE_DB_URL: its Postgres certificate chains to Supabase's own
# CA, which no system trust store holds. Supabase dashboard > Project Settings > Database > SSL Configuration >
# Download certificate. Keep the file outside the repository, e.g. ~/.config/firstseen/supabase-prod-ca-2021.crt.
# SUPABASE_DB_CA_CERT=
# Turns certificate verification off, for a self-hosted server with no CA file only. Preflight refuses it in production.
# SUPABASE_DB_SSL_INSECURE=false

# Renders the development fixture dashboard, and only when no database is configured.
# Leave it commented out: an unconfigured deployment should show an empty workspace, never
# fixture forecasts. Production must not set it at all, not even to "false".
# FIRSTSEEN_DEMO_MODE=true

# Server-only Google Calendar OAuth. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback
# 32 random bytes encoded as base64url, for example: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Server-only Gmail OAuth and explicit development delivery gate.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
EMAIL_TOKEN_ENCRYPTION_KEY=
EMAIL_DIGEST_SEND_ENABLED=false

# Comma-separated LiteLLM model routes are tried from left to right.
# Capability routes inherit LLM_DEFAULT_ROUTES when empty. LLM_MODEL remains a
# backward-compatible single-route default for local development.
LLM_MODEL=ollama/qwen2.5:7b
LLM_DEFAULT_ROUTES=
LLM_EXTRACT_ROUTES=
LLM_CLASSIFY_ROUTES=
LLM_NORMALIZE_ROUTES=
LLM_REASON_ROUTES=
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_BASE=http://localhost:11434
LLM_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=20
BROWSER_TIMEOUT_SECONDS=30
# Courtesy pacing per origin; collection does not perform automatic retries.
HTTP_MIN_HOST_INTERVAL_SECONDS=0.25
# Real ATS boards exceed the 2 MB default; 10 MB is the supported maximum.
MAX_SOURCE_BYTES=10000000
# Honour robots.txt before every collector request (worker/src/firstseen/robots.py). Off by default, so collection
# behaves exactly as it did before; docs/takedown.md records what turning it on was measured to skip. The web app
# reads the same variable so /data-sources states which rule collection follows: set the same value in both places.
ROBOTS_TXT_ENFORCED=false

# Reddit collection uses an approved OAuth Data API application only. It is
# intentionally off until access, an allowlist, and a descriptive user agent
# have been configured. Cloud LLM extraction stays separately opt-in.
REDDIT_API_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_COMMUNITIES=cscareerquestions,csMajors
REDDIT_SEARCH_LIMIT=25
REDDIT_LLM_EXTRACTION_ENABLED=false

# Required for the streaming agent API in production. The web proxy and API
# must share this server-only value; never expose it through NEXT_PUBLIC_*.
# The Python service also serves Forecast Replay and readiness-plan generation, so
# /replay and the "Generate preparation plan" action need it before they work.
AGENT_API_BEARER_TOKEN=
FIRSTSEEN_AGENT_API_URL=http://127.0.0.1:8000
# Local-only escape hatch for a deliberately unauthenticated demo. Keep false in shared environments.
ALLOW_UNAUTHENTICATED_AGENT_DEV=false

# Optional. Lets a model interpret an unrecognised recruiting question into the
# typed tools it needs. It can only widen tool selection: it never produces a date,
# an interval, a confidence value, or any evidence, and the agent stays fully
# deterministic when this is false or every route fails.
AGENT_INTENT_LLM_ENABLED=false

# Per-token ceiling on the agent HTTP surface, counted within one process. The
# deployed service runs a small max-instances, so the effective limit is this
# value times the instance count. See docs/deployment.md.
AGENT_API_RATE_LIMIT_PER_MINUTE=60

# Consecutive failed scheduled runs before `npm run health:collection` reports a workflow unhealthy.
# COLLECTION_HEALTH_FAILURE_STREAK=3

# Deploy-script inputs. Export them for the one command; the running product never reads them.
# scripts/deploy-web.sh
# WEB_DOMAIN=1stseen.win
# scripts/deploy-agent.sh (PROJECT_ID falls back to gcloud's configured project)
# PROJECT_ID=
# REGION=us-west1
# SERVICE=firstseen-agent
# REPO=firstseen
# SA_NAME=firstseen-agent
# IMAGE_TAG=

# Production health checks (scripts/ops-health.mjs, docs/operations.md). GitHub Actions variables and a secret; set
# locally only to run the check by hand.
# FIRSTSEEN_WEB_URL=https://firstseen.example.com
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ANALYTICS_TOKEN=
