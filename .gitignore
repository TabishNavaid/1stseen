# Retake it rather than keep it (apps/web/app/layout.tsx).
/scripts/assets/og-source.png

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# local Supabase
supabase/.temp/
supabase/.branches/
