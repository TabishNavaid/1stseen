/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
**/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
*.tsbuildinfo

# vercel
.vercel

**/dist/
**/.wrangler/
/outputs/
/work/
# scripts/bootstrap-companies.sh discovery output
/.bootstrap-logs/
